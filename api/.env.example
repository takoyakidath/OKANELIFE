# Copy to .env (same directory as bootstrap.php) on the Lolipop server.
# Never commit the real .env file.

DB_DRIVER=mysql
DB_HOST=mysqlXXX.lolipop.jp
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_user
DB_PASS=your_password

# Random 64+ char secret used to sign access tokens (HS256). Rotating it
# invalidates every issued access token (refresh tokens are unaffected).
JWT_SECRET=change-me-to-a-long-random-string

# Must match the Next.js app's GOOGLE_CLIENT_ID exactly — this backend
# verifies the ID token's audience against it.
GOOGLE_CLIENT_ID=

# If the API is mounted under a subpath (e.g. https://example.lolipop.jp/api),
# set it here so route matching strips it. Leave empty if index.php is the
# document root.
API_BASE_PATH=/api
